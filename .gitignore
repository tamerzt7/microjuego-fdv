# This file is used to ignore files which are generated
# if you want to use git, this file is essential so you don't
# have too much crap in your git repository. Remember it is
# almost impossible to share just files with your coworkers
# if your has contraints like this. Take care that you exclude
# the following files:
# - you never sould ignore the Library folder
# - you never sould ignore the ProjectSettings folder

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They all start with the word "capture" followed by numbers and the .unitypackage extension
[Mm]emory[Cc]aptures/
*.unitypackage

# Recordings can get excessive in size
[Rr]ecordings/

# Uncomment this if you have LFS enabled for .unitypackage files, using Git LFS.
# git lfs install
# *.unitypackage filter=lfs diff=lfs merge=lfs -text

# Asset meta data should just be committed to git.
# If you get merge conflicts on files, allocating new guids solves the problem.
# See https://docs.unity3d.com/Manual/SourceControllingMetaFiles.html

# Stupid Mac shit
.DS_Store

# Rider (Jetbrains IDE) cache/options directory
.idea/
*.sln.iml

# VS Code
.vscode/
.VSCode/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
crash.log
crash.*.log

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
